{
	"godotTools.editorPath.godot4": "e:\\Godot_v4.6-stable_mono_win64\\Godot_v4.6-stable_mono_win64.exe",
	// GDScript 専用設定
	"[gdscript]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.detectIndentation": false,
		"editor.formatOnSave": true
	},
	// エディタ全般
	"editor.detectIndentation": false,
	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"editor.formatOnSave": true,
	// ファイル保存時の処理
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	// 視覚的表示
	"editor.renderWhitespace": "boundary",
	"editor.rulers": [
		80,
		100
	],
	// ファイル除外（オプション）
	"files.exclude": {
		"**/.godot": true,
		"**/.import": true
	}
}
